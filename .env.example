# ───────────────────────── Database (Neon) ─────────────────────────
# Pooled connection (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct connection (pooling OFF). Used only by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ───────────────────────── Site ─────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ───────────────────────── Auth.js (M2) ─────────────────────────
# Required. Generate with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Optional. Leave empty to hide the "Continue with Google" button.
# Google Cloud Console → Credentials → OAuth client (Web).
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ───────────────────────── File storage (M2) ─────────────────────────
# Vercel Blob needs TWO stores: one Public (photos/logos) and one Private (documents).
# Leave both empty in development: files are then saved to ./public/uploads and ./.private-uploads.
# In production both are REQUIRED.
BLOB_PUBLIC_READ_WRITE_TOKEN=""
BLOB_PRIVATE_READ_WRITE_TOKEN=""

# ───────────────────────── Seed ─────────────────────────
# Password for admin@tvdehub.pt created by `npm run db:seed`
SEED_ADMIN_PASSWORD="ChangeMe123!"

# ───────────────────────── Coming in later milestones ─────────────────────────
# M4: Resend emails
RESEND_API_KEY=""
EMAIL_FROM="TVDE Hub <no-reply@example.com>"
# M4: Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# M5: protects the document-expiry cron endpoint
CRON_SECRET=""
